# Development - .NET 10 con Hot Reload
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS development
WORKDIR /app

COPY backend/UrbaPF.sln ./UrbaPF.sln
COPY backend/UrbaPF.Api/*.csproj ./UrbaPF.Api/
COPY backend/UrbaPF.Domain/*.csproj ./UrbaPF.Domain/
COPY backend/UrbaPF.Application/*.csproj ./UrbaPF.Application/
COPY backend/UrbaPF.Infrastructure/*.csproj ./UrbaPF.Infrastructure/
COPY backend/UrbaPF.Tests/*.csproj ./UrbaPF.Tests/
RUN dotnet restore UrbaPF.sln

COPY backend/ .

WORKDIR /app/UrbaPF.Api
RUN dotnet build -c Debug

ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV ASPNETCORE_ENVIRONMENT=Development

EXPOSE 5000

# Ejecutar en modo debug
CMD ["dotnet", "run", "--no-build", "--urls", "http://+:5000"]
