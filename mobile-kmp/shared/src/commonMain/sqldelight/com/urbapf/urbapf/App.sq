CREATE TABLE pendingMutation (
  mutationId TEXT PRIMARY KEY,
  entityType TEXT NOT NULL,
  entityId TEXT NOT NULL,
  operation TEXT NOT NULL,
  payloadJson TEXT NOT NULL,
  clientCreatedAt TEXT NOT NULL,
  state TEXT NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0
);

insertPendingMutation:
INSERT INTO pendingMutation(
  mutationId,
  entityType,
  entityId,
  operation,
  payloadJson,
  clientCreatedAt,
  state,
  attempts
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectPendingMutations:
SELECT * FROM pendingMutation
WHERE state = ?
ORDER BY clientCreatedAt ASC;

deleteAppliedMutations:
DELETE FROM pendingMutation
WHERE state = 'applied';